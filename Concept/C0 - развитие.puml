@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title Экосистема Bidmart – TRANSINET – CTT EDI (C4 Level C0)

Person(customer, "Заказчик / Грузовладелец", "Планирует закупки, формирует потребности, контролирует поставки и документы.")
Person(carrier, "Перевозчик / Логист", "Выполняет перевозки, управляет транспортом и рейсами.")
Person(accountant, "Бухгалтер / Финансист", "Работает с первичными документами, ЭДО и расчётами.")
Person(controller, "Регулятор / Контролирующие органы", "Проверяют прослеживаемость, корректность документов и соблюдение законодательства.")

System(bidmart, "Bidmart", "Система электронных закупок и тендерных процедур.")
System(transinet, "TRANSINET", "Платформа управления перевозками, автопарком и логистическими операциями.")
System(cttedi, "CTT EDI", "Аттестованный EDI‑провайдер, система юридически значимого электронного документооборота.")

Rel(customer, bidmart, "Формирует потребности, создаёт заявки и участвует в закупочных процедурах")
Rel(customer, transinet, "Создаёт и контролирует заказы на перевозку, отслеживает статусы доставки")
Rel(customer, cttedi, "Подписывает и согласует электронные документы (e‑ТН, e‑ТТН, акты, договоры) с помощью ЭЦП")

Rel(carrier, transinet, "Планирует и исполняет рейсы, передаёт телематические события")
Rel(carrier, cttedi, "Получает, подписывает и отправляет э‑накладные и другие документы")
Rel(accountant, cttedi, "Работает с юридически значимыми электронными документами и архивом")
Rel(controller, cttedi, "Получает доступ к юридически значимым данным и проверяет соответствие требованиям")

Rel(bidmart, transinet, "Передаёт утверждённые заказы и условия логистики", "API / интеграционная шина")
Rel(transinet, bidmart, "Возвращает статусы исполнения и KPI по поставкам", "API / интеграционная шина")

Rel(transinet, cttedi, "Инициирует создание э‑документов по событиям рейсов, обновляет статусы", "REST/SOAP API, webhooks")
Rel(cttedi, transinet, "Возвращает статусы обработки документов (подписано, отклонено и т.д.)", "REST/SOAP API, webhooks")

Rel(bidmart, cttedi, "Формирует и обновляет контракты и иные документы по результатам процедур", "API / EDI‑интеграция")
Rel(cttedi, bidmart, "Передаёт статусы подписания и юридической актуальности документов", "API / EDI‑интеграция")

SHOW_LEGEND()
@enduml
